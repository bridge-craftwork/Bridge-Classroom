# Bridge Classroom Vue App Configuration

# API server URL (no trailing slash)
VITE_API_URL=http://localhost:3000/api

# API key for authenticating with the server (same as server's API_KEY)
VITE_API_KEY=your-api-key-here

# Double-dummy solver (bridge-solver-service). Optional — defaults to the
# public host https://solver.bridge-craftwork.com when unset. Override to point
# at a local solver, e.g. VITE_SOLVER_URL=http://localhost:8005
# VITE_SOLVER_URL=
