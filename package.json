{
  "name": "bridge-classroom",
  "private": true,
  "version": "0.1.0",
  "description": "Bridge teaching platform with student progress tracking",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-rbb-wasm.mjs --soft",
    "dev": "vite",
    "prebuild": "node scripts/fetch-rbb-wasm.mjs",
    "build": "vite build",
    "fetch:rbb-wasm": "node scripts/fetch-rbb-wasm.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "harness:gallery": "bash scripts/harness-gallery.sh",
    "a1:gallery": "bash scripts/a1-gallery.sh",
    "dev:shots": "bash scripts/dev-shots.sh",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bridge-craftwork/convention-card": "github:bridge-craftwork/convention-card#v0.6.0",
    "modern-screenshot": "^4.7.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.3.0",
    "playwright": "^1.61.1",
    "vite": "^5.4.0",
    "vitest": "^4.0.17",
    "wrangler": "^4.106.0"
  }
}
